{
  "signal": [
    [
      "Synchronous FIFO (depth 4, already empty)",
      { "name": "clk", "wave": "p......." },
      { "name": "pop_request", "wave": "010....." },
      { "name": "pop_accepted", "wave": "0......." },
      { "name": "dout_valid", "wave": "0......." },
      { "name": "read_ptr", "wave": "=.......", "data": ["1"] },
      { "name": "occupancy", "wave": "=.......", "data": ["0"] },
      { "name": "empty", "wave": "1......." },
      { "name": "full", "wave": "0......." }
