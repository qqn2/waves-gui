{
  "signal": [
    [
      "APB write held in access",
      { "name": "PCLK", "wave": "P........." },
      { "name": "PSEL", "wave": "0.1...0..." },
      { "name": "PENABLE", "wave": "0..1..0..." },
      { "name": "PWRITE", "wave": "0.1...0..." },
      { "name": "PADDR[15:0]", "wave": "x.=.......", "data": ["0x1004"] },
      { "name": "PWDATA[31:0]", "wave": "x.=.......", "data": ["0xCAFEBABE"] },
      { "name": "PREADY", "wave": "1..0.1...." }
    ]
  ],
  "head": { "text": "APB write with wait states" },
  "foot": {
    "text": "Once access begins, PSEL, PENABLE, PWRITE, address, and write data remain stable while PREADY=0. The write completes only on the final access cycle with PREADY=1."
  },
  "config": { "hscale": 2 }
}
