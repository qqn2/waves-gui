{
  "head": { "text": "AXI RLAST marks exactly the final read-data beat" },
  "config": { "hscale": 2 },
  "signal": [
    [
      "Read-address channel",
      { "name": "ACLK", "wave": "P..........." },
      { "name": "ARADDR[31:0]", "wave": "x.=x........", "data": ["0x0000_0200"] },
      { "name": "ARLEN[7:0]", "wave": "x.=x........", "data": ["3 (4 beats)"] },
      { "name": "ARVALID", "wave": "0.10........" },
      { "name": "ARREADY", "wave": "0.10........" }
    ],
    {},
    [
      "Read-data channel",
      { "name": "RVALID", "wave": "0...1...0..." },
      { "name": "RREADY", "wave": "1..........." },
      { "name": "RDATA[31:0]", "wave": "x...=234x...", "data": ["D0", "D1", "D2", "D3"] },
      { "name": "RRESP[1:0]", "wave": "x...=...x...", "data": ["OKAY"] },
      { "name": "RLAST", "wave": "0......10..." }
    ]
  ],
  "foot": {
    "text": "ARLEN=3 requests four read beats. RLAST is low on D0 through D2 and high only with D3, the fourth and final RVALID/RREADY transfer; it is not a separate handshake."
  }
}
