{
  "head": { "text": "A bridge converts one upstream request into APB SETUP then ACCESS" },
  "config": { "hscale": 2 },
  "signal": [
    [
      "Upstream side",
      { "name": "req_accept", "wave": "0.10...." },
      { "name": "req_write", "wave": "0.1....." },
      { "name": "req_addr[11:0]", "wave": "x.=.....", "data": ["0x040"] },
      { "name": "req_wdata[31:0]", "wave": "x.=.....", "data": ["0x12345678"] }
    ],
    {},
    [
      "APB side",
      { "name": "PCLK", "wave": "P......." },
      { "name": "PSEL", "wave": "0.1.0..." },
      { "name": "PENABLE", "wave": "0..10..." },
      { "name": "PWRITE", "wave": "0.1.0..." },
      { "name": "PADDR[11:0]", "wave": "x.=.....", "data": ["0x040"] },
      { "name": "PWDATA[31:0]", "wave": "x.=.....", "data": ["0x12345678"] },
      { "name": "PREADY", "wave": "1......." }
    ]
  ],
  "foot": {
    "text": "After the bridge accepts the upstream write, it drives PSEL with PENABLE=0 for SETUP, then asserts PENABLE for the completing ACCESS cycle."
  }
}
