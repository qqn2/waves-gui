{
  "head": { "text": "AXI4-Lite SLVERR response from a selected peripheral" },
  "config": { "hscale": 2 },
  "signal": [
    { "name": "ACLK", "wave": "P........" },
    {},
    [
      "Read address accepted by UART",
      { "name": "ARVALID", "wave": "0.10....." },
      { "name": "ARREADY", "wave": "0.10....." },
      { "name": "ARADDR[31:0]", "wave": "x.=.x....", "data": ["0x4000_0010 (UART status)"] },
      { "name": "UART_SEL", "wave": "0.10....." }
    ],
    {},
    [
      "Peripheral response",
      { "name": "RVALID", "wave": "0....10.." },
      { "name": "RREADY", "wave": "0....10.." },
      { "name": "RDATA[31:0]", "wave": "x....=x..", "data": ["implementation-defined"] },
      { "name": "RRESP[1:0]", "wave": "x....=x..", "data": ["SLVERR"] }
    ]
  ],
  "foot": { "text": "SLVERR reports that the selected slave accepted the request but could not complete it successfully. Unlike DECERR, address decode selected a real target." }
}
