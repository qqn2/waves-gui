{
  "head": { "text": "Full AHB locked sequence defers a competing bus request" },
  "config": { "hscale": 2 },
  "signal": [
    [
      "Master and arbiter lock signals",
      { "name": "HBUSREQ0", "wave": "0.1......." },
      { "name": "HLOCK0", "wave": "0.11.0...." },
      { "name": "HBUSREQ1", "wave": "0..1......" },
      { "name": "HGRANT0", "wave": "0.1110...." },
      { "name": "HGRANT1", "wave": "0....10.." }
    ],
    {},
    [
      "Locked address phases",
      { "name": "HCLK", "wave": "P........" },
      { "name": "HMASTLOCK", "wave": "0.11.0...." },
      { "name": "address master", "wave": "x.=2x=...", "data": ["M0", "M0", "M1"] },
      { "name": "HTRANS", "wave": "x.=2x=...", "data": ["NONSEQ", "SEQ", "NONSEQ"] },
      { "name": "HADDR[31:0]", "wave": "x.=2x=...", "data": ["0x5000", "0x5004", "0x6000"] },
      { "name": "HREADY", "wave": "1........" }
    ]
  ],
  "foot": {
    "text": "While M0 asserts HLOCK0 for its NONSEQ/SEQ pair, the arbiter keeps M0 granted even though M1 requests. The grant changes only after the locked sequence ends."
  }
}
