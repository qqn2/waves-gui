{
  "head": { "text": "AXI4-Lite write: address handshake can precede write data" },
  "config": { "hscale": 2 },
  "signal": [
    [
      "Address write channel",
      { "name": "ACLK", "wave": "P........." },
      { "name": "AWADDR[31:0]", "wave": "x.=.......", "data": ["0x40000014"] },
      { "name": "AWVALID", "wave": "0.1.0....." },
      { "name": "AWREADY", "wave": "0..1......" }
    ],
    {},
    [
      "Write data channel",
      { "name": "WDATA[31:0]", "wave": "x....=....", "data": ["0x00000007"] },
      { "name": "WSTRB[3:0]", "wave": "x....=....", "data": ["0xF"] },
      { "name": "WVALID", "wave": "0....1.0.." },
      { "name": "WREADY", "wave": "0.....1..." }
    ],
    {},
    [
      "Write response channel",
      { "name": "BRESP[1:0]", "wave": "x......=..", "data": ["OKAY"] },
      { "name": "BVALID", "wave": "0......1.0" },
      { "name": "BREADY", "wave": "0.......1." }
    ]
  ],
  "foot": {
    "text": "The AW payload is held from AWVALID until its handshake. W may arrive later; the write is not complete until both independent channel handshakes have occurred."
  }
}
