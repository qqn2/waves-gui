{
  "signal": [
    [
      "Write to TIMER then GPIO",
      { "name": "PCLK", "wave": "P........." },
      { "name": "PSEL_TIMER", "wave": "0.1.0....." },
      { "name": "PSEL_GPIO", "wave": "0...1.0..." },
      { "name": "PENABLE", "wave": "0..1010..." },
      { "name": "PWRITE", "wave": "0.1...0..." },
      { "name": "PADDR[15:0]", "wave": "x.=.=.....", "data": ["0x1000", "0x2000"] },
      { "name": "PWDATA[31:0]", "wave": "x.=.=.....", "data": ["0x00000011", "0x00000022"] },
      { "name": "PREADY", "wave": "1........." }
    ]
  ],
  "head": { "text": "Back-to-back APB transfers to different peripherals" },
  "foot": {
    "text": "After TIMER access completes, PENABLE returns low and the decode changes to PSEL_GPIO for the next setup cycle. The two peripheral selects never overlap."
  },
  "config": { "hscale": 2 }
}
