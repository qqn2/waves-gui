{
  "head": { "text": "AXI4-Lite AR-channel backpressure" },
  "config": { "hscale": 2 },
  "signal": [
    { "name": "ACLK", "wave": "P.........." },
    {},
    [
      "Read address held until accepted",
      { "name": "ARVALID", "wave": "0..1...0..." },
      { "name": "ARREADY", "wave": "0.....1.0.." },
      { "name": "ARADDR[31:0]", "wave": "x..=...x...", "data": ["0x4000_0020 (held)"] },
      { "name": "ARPROT[2:0]", "wave": "x..=...x...", "data": ["0b000 (held)"] }
    ],
    {},
    [
      "Later response",
      { "name": "RVALID", "wave": "0.......10." },
      { "name": "RREADY", "wave": "0.......10." },
      { "name": "RDATA[31:0]", "wave": "x.......=x.", "data": ["0x2468_ACE0"] },
      { "name": "RRESP[1:0]", "wave": "x.......=x.", "data": ["OKAY"] }
