{
  "head": { "text": "AXI4-Lite write: AW and W may handshake in the same cycle" },
  "config": { "hscale": 2 },
  "signal": [
    [
      "Address write channel",
      { "name": "ACLK", "wave": "P......." },
      { "name": "AWADDR[31:0]", "wave": "x.=.....", "data": ["0x40000010"] },
      { "name": "AWVALID", "wave": "0.10...." },
      { "name": "AWREADY", "wave": "0.1....." }
    ],
    {},
    [
      "Write data channel",
      { "name": "WDATA[31:0]", "wave": "x.=.....", "data": ["0xCAFE0001"] },
      { "name": "WSTRB[3:0]", "wave": "x.=.....", "data": ["0xF"] },
      { "name": "WVALID", "wave": "0.10...." },
      { "name": "WREADY", "wave": "0.1....." }
    ],
    {},
    [
      "Write response channel",
      { "name": "BRESP[1:0]", "wave": "x...=...", "data": ["OKAY"] },
      { "name": "BVALID", "wave": "0...1.0." },
      { "name": "BREADY", "wave": "0....1.." }
    ]
  ],
  "foot": {
    "text": "AW and W are independent AXI4-Lite channels, so both handshakes may occur together. The slave then returns one B response after accepting both."
  }
}
