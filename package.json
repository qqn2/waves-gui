{
  "name": "waves-gui",
  "private": true,
  "version": "0.1.0",
  "description": "Client-only visual editor for WaveDrom and Undulate timing diagrams.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqn2/waves-gui.git"
  },
  "bugs": {
    "url": "https://github.com/qqn2/waves-gui/issues"
  },
  "homepage": "https://github.com/qqn2/waves-gui#readme",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run licenses:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude src/undulateBridge/visualConformance.test.ts",
    "test:visual": "vitest run src/undulateBridge/visualConformance.test.ts",
    "test:security": "vitest run src/security/hostileInput.test.ts",
    "test:e2e": "playwright test",
    "confidentiality:check": "node scripts/check-confidentiality.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-production-artifact.mjs",
    "check": "npm run confidentiality:check && npm run lint && npm test && npm run test:visual && npm run test:security && npm run build && npm run licenses:check",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "file-saver": "^2.0.5",
    "immer": "^11.1.18",
    "jju": "1.4.0",
    "lucide-react": "^1.41.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.8.0",
    "use-debounce": "^10.0.4",
    "wavedrom": "^3.7.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.62.0",
    "@types/file-saver": "^2.0.7",
    "@types/jju": "1.4.5",
    "@types/node": "20.19.41",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "happy-dom": "^20.11.1",
    "json5": "^2.2.3",
    "sharp": "^0.35.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
