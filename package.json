{
  "name": "waves-gui",
  "private": true,
  "version": "0.1.0",
  "description": "Client-only visual editor for WaveDrom-compatible timing diagrams.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqn2/waves-gui.git"
  },
  "bugs": {
    "url": "https://github.com/qqn2/waves-gui/issues"
  },
  "homepage": "https://github.com/qqn2/waves-gui#readme",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run licenses:generate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:security": "vitest run src/security/hostileInput.test.ts",
    "test:e2e": "playwright test",
    "confidentiality:check": "node scripts/check-confidentiality.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/check-production-artifact.mjs",
    "check": "npm run confidentiality:check && npm run lint && npm test && npm run test:security && npm run build && npm run licenses:check",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "file-saver": "^2.0.5",
    "immer": "^10.1.1",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.1.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-debounce": "^10.0.4",
    "wavedrom": "^3.6.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.61.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "happy-dom": "^20.9.0",
    "json5": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.110.0"
  }
}
